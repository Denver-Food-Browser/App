# API Host Configuration
# This file is auto-generated by `bun run setup-env`
# For local development, the script will detect your IP and configure this automatically

# The setup script will set this to http://<your-local-ip>:8055
PUBLIC_API_HOST=http://{IP-ADDRESS}:8055

# Manual configuration examples:
# - iOS Simulator: Use your local IP (auto-detected)
# - Android Emulator: http://10.0.2.2:8055
# - Physical Device: Use your local IP (same WiFi network)
# - Production: https://api.your-domain.com
