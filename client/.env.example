
# Database Configuration
DB_USER=changeme
DB_PASSWORD=changeme
DB_DATABASE=food-browser
DB_CLIENT=sqlite3
DB_FILENAME=/database/data.db

# Directus Configuration
DIRECTUS_PORT=8055
DIRECTUS_SECRET=gobbledeegook
# Cache Configuration
CACHE_ENABLED=true
CACHE_AUTO_PURGE=true

# Admin Configuration - Commented out to use onboarding in blank template
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=d1r3ctu5

# WebSocket Configuration
WEBSOCKETS_ENABLED=true

# URL Configuration
PUBLIC_URL=http://YOUR-IP:8055
# Create magic links for user registration & password reset
USER_REGISTER_URL_ALLOW_LIST="http://YOUR-IP/verify,https://denver-food-browser.net/verify"
PASSWORD_RESET_URL_ALLOW_LIST="http://YOUR-IP/reset-password,https://denver-food-browser.net/reset-password"

# CORS allows back-end API to inspect requests from a particular origin, i.e. from an IP address
# CORS Configuration:
# Development: It's ok to use "*" or "http://localhost:3000" for local testing
# Production: Specify exact origins like:
#  - Single origin: "https://your-domain.com"
#  - Multiple origins: "https://app.domain.com,https://admin.domain.com"
# Warning: Using "*" in production is a security risk - always specify allowed origins
CORS_ENABLED=true
CORS_ORIGIN=tauri://localhost,http://YOUR-IP:1420,http://localhost:1420,http://YOUR-IP:3000,http://localhost:3000

TZ=America/Denver

# Cookie Configuration
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=lax
REFRESH_TOKEN_COOKIE_DOMAIN=localhost

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=localhost

# Extensions Configuration
EXTENSIONS_PATH=./extensions
EXTENSIONS_AUTO_RELOAD=true

# Content Security Policy
CONTENT_SECURITY_POLICY_DIRECTIVES__FRAME_SRC=http://localhost:3000,http://localhost:4321,http://localhost:5173,https://*.youtube.com,https://*.vimeo.com,https://*.wistia.net,https://*.loom.com

LOG_LEVEL="debug"

EMAIL_TRANSPORT=smtp
EMAIL_FROM=no-reply@denver-food-browser.net
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASSWORD=changeme
EMAIL_TEMPLATES_PATH=./templates

# Change in production
PUBLIC_CLIENT_URL=http://YOUR-IP:1420
FLOWS_ENV_ALLOW_LIST="PUBLIC_CLIENT_URL,DIRECTUS_SECRET"