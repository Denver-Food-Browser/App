{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "denver-food-browser",
  "version": "0.1.0",
  "identifier": "com.denverfoodbrowser.app",
  "build": {
    "beforeDevCommand": "$HOME/.bun/bin/bun run start-vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "$HOME/.bun/bin/bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "denver-food-browser",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
